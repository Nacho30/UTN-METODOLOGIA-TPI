# Copiar como .env (que NO se sube a Git) y completar con valores propios.
# Clave de la base PostgreSQL de Docker (inventar una).
POSTGRES_PASSWORD=
# Secreto para firmar los JWT: al menos 32 caracteres al azar.
# Se puede generar con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
ODONTOLOGIA_JWT_SECRETO=
# Clave de los usuarios ficticios de demostración (recepcion, profesional, admin).
# Mínimo 8 caracteres. Inventar una; no usar una clave real.
ODONTOLOGIA_CLAVE_DEMO=
